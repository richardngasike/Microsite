# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-min-50-chars
DEBUG=False
ALLOWED_HOSTS=your-api-domain.onrender.com,localhost,127.0.0.1

# ── CORS: frontend origins that may call this API ─────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Supabase Postgres (Transaction pooler recommended for Render) ──────────
# Supabase → Settings → Database → Connection string → Transaction pooler URI
# Must use postgres:// not postgresql:// — the parser handles both
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-xx-x.pooler.supabase.com:6543/postgres

# ── Supabase Storage ───────────────────────────────────────────────────────
# Supabase → Settings → API → Project URL and service_role key
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_BUCKET=documents
